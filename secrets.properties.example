# Copy this file to secrets.properties and fill in values.
# secrets.properties is gitignored; never commit real keys.

# Fire in Firebase: set true AND drop google-services.json into app/.
# Kept false the app runs fully on in-memory mock data.
FIREBASE_ENABLED=false
FIREBASE_DATABASE_URL=https://sisarasa-d93f2-default-rtdb.asia-southeast1.firebasedatabase.app/

# Google Maps SDK key (for embedded pickup map). Empty = app falls back to
# "Open in Google Maps" deep link. Set a real key to enable the embedded map.
MAPS_API_KEY=

# Supabase (free photo storage). Both are client-safe and feed BuildConfig.
# Leave empty = app stores posts without a photo (local mock behaviour).
SUPABASE_URL=
SUPABASE_ANON_KEY=
